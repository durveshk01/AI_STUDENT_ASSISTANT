# Local PostgreSQL/pgvector connection string
DATABASE_URL=postgresql://study_user:study_password@localhost:5432/study_assistant

# AI provider credentials (keep real keys in .env, never commit them)
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Leave blank for a private generated local key; set a private random value in production.
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional: use a private Supabase Storage bucket for persistent uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-documents

# Used by the Next.js frontend at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
